{
  "manifest_version": 3,
  "name": "直播吧 Modern — Zhibo8 现代主题",
  "short_name": "Zhibo8 Modern",
  "version": "1.1.0",
  "version_name": "1.1.0",
  "description": "为直播吧首页、频道页与直播详情页带来现代布局、清爽排版与明暗主题，并保留原有内容与功能。开源、无追踪。",
  "homepage_url": "https://github.com/niexia/zhibo8-modern",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "直播吧 Modern",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://zhibo8.com/*",
        "https://www.zhibo8.com/*",
        "https://news.zhibo8.com/*"
      ],
      "css": [
        "theme.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
